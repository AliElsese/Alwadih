{
  "info": {
    "_postman_id": "a9d3e8e1-5e92-491c-b2e1-953e77a72d3f",
    "name": "Alwadih Backend API",
    "description": "Comprehensive Postman collection for the Alwadih API including Authentication, Google Sign-in / Sign-up, Account Verification with 4-digit OTP, and Password Reset flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "reset_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "General",
      "item": [
        {
          "name": "Health Check / Hello",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Root endpoint to verify the API server is up and running."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Signup (Register & Send OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"user@example.com\",\n  \"password\": \"SecretPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/signup",
              "host": ["{{base_url}}"],
              "path": ["auth", "signup"]
            },
            "description": "Registers a new user, hashes the password, creates an unverified account, generates a 4-digit OTP, and emails it to the user."
          },
          "response": []
        },
        {
          "name": "2. Verify Account OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-otp"]
            },
            "description": "Verifies the 4-digit OTP sent to the user's email upon signup, marking the account as isVerified: true."
          },
          "response": []
        },
        {
          "name": "3. Resend Account OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/resend-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "resend-otp"]
            },
            "description": "Generates a fresh 4-digit OTP and resends it to the user's email if the previous one expired or was not received."
          },
          "response": []
        },
        {
          "name": "4. Google Register / Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set('jwt_token', data.token);",
                  "        console.log('jwt_token saved to collection variables');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<GOOGLE_ID_OR_ACCESS_TOKEN>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/google",
              "host": ["{{base_url}}"],
              "path": ["auth", "google"]
            },
            "description": "Registers a new user or logs in an existing user with Gmail / Google. Accepts Google idToken, token, or credential. Generates JWT token and marks account as verified automatically."
          },
          "response": []
        },
        {
          "name": "5. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set('jwt_token', data.token);",
                  "        console.log('jwt_token saved to collection variables');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecretPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates a verified user and returns a signed JWT access token. If account is not verified, returns 401 Unauthorized."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Password Reset",
      "item": [
        {
          "name": "1. Forgot Password (Request Reset OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "forgot-password"]
            },
            "description": "Step 1 of password reset. Checks that user exists, generates a 4-digit reset OTP, and emails it."
          },
          "response": []
        },
        {
          "name": "2. Resend Reset OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/resend-reset-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "resend-reset-otp"]
            },
            "description": "Generates a fresh 4-digit reset OTP and resends it if the previous one expired."
          },
          "response": []
        },
        {
          "name": "3. Verify Reset OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    if (data.resetToken) {",
                  "        pm.collectionVariables.set('reset_token', data.resetToken);",
                  "        console.log('reset_token saved to collection variables');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-reset-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-reset-otp"]
            },
            "description": "Step 2 of password reset. Verifies the 4-digit OTP code and generates a temporary resetToken valid for 15 minutes."
          },
          "response": []
        },
        {
          "name": "4. Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"newPassword\": \"NewSecretPass123!\",\n  \"resetToken\": \"{{reset_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "reset-password"]
            },
            "description": "Step 3 of password reset. Changes user password using the resetToken obtained in Step 2. Automatically invalidates reset tokens once completed."
          },
          "response": []
        }
      ]
    }
  ]
}
