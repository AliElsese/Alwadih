  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "accept_language",
      "value": "en",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "reset_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "part_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "General",
      "item": [
        {
          "name": "Health Check / Hello",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Root endpoint to verify the API server is up and running. Returns greeting in English or Arabic depending on Accept-Language header."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Signup (Register & Send OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"user@example.com\",\n  \"password\": \"SecretPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "description": "Registers a new user account, securely hashes the password, generates a 4-digit verification code, and sends it via email in the requested language (ar/en)."
          },
          "response": []
        },
        {
          "name": "2. Verify Account OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "description": "Verifies the 4-digit code sent to the user's email upon signup and activates the account."
          },
          "response": []
        },
        {
          "name": "3. Resend Account OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/resend-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "resend-otp"
              ]
            },
            "description": "Generates a fresh 4-digit verification code and resends it to the user's email if the previous code expired or was not received."
          },
          "response": []
        },
        {
          "name": "4. Google Register / Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set('jwt_token', data.token);",
                  "        console.log('jwt_token saved to collection variables');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<GOOGLE_ID_OR_ACCESS_TOKEN>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/google",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "google"
              ]
            },
            "description": "Authenticates a user via Google/Gmail. Registers new users automatically with verified status, or logs in existing accounts, returning a signed JWT access token."
          },
          "response": []
        },
        {
          "name": "5. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set('jwt_token', data.token);",
                  "        console.log('jwt_token saved to collection variables');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecretPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticates a verified user and returns a signed JWT access token. Returns 401 Unauthorized if credentials are invalid or if the email is not verified."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin Authentication",
      "item": [
        {
          "name": "1. Admin Login (Step 1: Check Credentials & Send 2FA OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"AdminSecret123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/admin/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "admin",
                "login"
              ]
            },
            "description": "Validates administrator credentials and triggers a 4-digit 2FA login verification code sent via email. Does not return an access token."
          },
          "response": []
        },
        {
          "name": "2. Verify Admin Login 2FA OTP (Step 2: Get Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set('jwt_token', data.token);",
                  "        console.log('Admin jwt_token saved to collection variables');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"otp\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/admin/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "admin",
                "verify-otp"
              ]
            },
            "description": "Verifies the 4-digit admin 2FA login code and returns a signed JWT access token (30-minute expiry) with the admin role."
          },
          "response": []
        },
        {
          "name": "3. Resend Admin Login 2FA OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/admin/resend-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "admin",
                "resend-otp"
              ]
            },
            "description": "Generates a fresh 4-digit 2FA login verification code and emails it to the admin."
          },
          "response": []
        },
        {
          "name": "4. Admin Forgot Password (Request Reset OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/admin/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "admin",
                "forgot-password"
              ]
            },
            "description": "Step 1 of Admin Password Reset. Generates a 4-digit reset code and emails it to the admin."
          },
          "response": []
        },
        {
          "name": "5. Resend Admin Reset OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/admin/resend-reset-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "admin",
                "resend-reset-otp"
              ]
            },
            "description": "Resends the 4-digit password reset code to the admin."
          },
          "response": []
        },
        {
          "name": "6. Verify Admin Reset OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    if (data.resetToken) {",
                  "        pm.collectionVariables.set('reset_token', data.resetToken);",
                  "        console.log('Admin reset_token saved to collection variables');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"otp\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/admin/verify-reset-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "admin",
                "verify-reset-otp"
              ]
            },
            "description": "Step 2 of Admin Password Reset. Validates the reset code and issues a temporary reset token valid for 15 minutes."
          },
          "response": []
        },
        {
          "name": "7. Admin Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"newPassword\": \"NewAdminSecret123!\",\n  \"resetToken\": \"{{reset_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/admin/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "admin",
                "reset-password"
              ]
            },
            "description": "Step 3 of Admin Password Reset. Sets the new password using the valid resetToken."
          },
          "response": []
        }
      ]
    },
