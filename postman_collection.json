    {
      "name": "Support Requests",
      "item": [
        {
          "name": "1. Create Support Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"suggestion\",\n  \"message\": \"Please add more reciters and customizable bookmarks.\",\n  \"idempotencyKey\": \"req-uuid-12345\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/support/create",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "support",
                "create"
              ]
            },
            "description": "Creates a new support request for the authenticated user. Supported categories: 'suggestion', 'technical_issue', 'note'. Supports optional 'idempotencyKey' for duplicate request protection."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User Preferences",
      "item": [
        {
          "name": "1. Get Preferences",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/preferences",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "preferences"
              ]
            },
            "description": "Retrieves the authenticated user's preferences. Returns defaults (medium font size, system appearance, ar language, sound true, haptics true) if none exist yet."
          },
          "response": []
        },
        {
          "name": "2. Update Preferences (Patch)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{accept_language}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fontSize\": \"large\",\n  \"appearance\": \"dark\",\n  \"language\": \"ar\",\n  \"sound\": true,\n  \"haptics\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/preferences",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "preferences"
              ]
            },
            "description": "Partially updates user preferences via PATCH. Allowed options: fontSize ('small', 'medium', 'large', 'extra large'), appearance ('system', 'dark', 'light'), language ('ar', 'en'), sound (boolean), haptics (boolean)."
          },
          "response": []
        }
      ]
    },
